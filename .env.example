# Copy to .env (git-ignored). Never commit real values.
# Slack app (see docs/slack-setup.md)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
# Optional overrides
# SHOWTIME_AGENTIA_BIN=/path/to/fake/agentia
# SHOWTIME_FFMPEG=/path/to/ffmpeg
# SLACK_API_URL=http://127.0.0.1:PORT/api/   # point Showtime at a stand-in Slack server (rehearsals)
