<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Urgent_Badge__c</fullName>
    <description>Shows URGENT on cases whose subject says they are urgent.</description>
    <externalId>false</externalId>
    <formula>IF(CONTAINS(LOWER(Subject), &quot;urgent&quot;), &quot;URGENT&quot;, &quot;&quot;)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Urgent Badge</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
