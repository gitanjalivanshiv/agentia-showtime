<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VIP_Badge__c</fullName>
    <description>Shows a VIP or Platinum badge on cases that belong to a VIP or Platinum account.</description>
    <externalId>false</externalId>
    <formula>IF(Account.VIP__c, &quot;VIP CUSTOMER&quot;, IF(TEXT(Account.Tier__c) = &quot;Platinum&quot;, &quot;PLATINUM CUSTOMER&quot;, &quot;&quot;))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>VIP Badge</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
